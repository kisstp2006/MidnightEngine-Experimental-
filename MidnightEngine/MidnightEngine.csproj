<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Core\" />
    <Folder Include="Engine\Graphics\Shaders\" />
    <Folder Include="Utils\" />
    <Folder Include="Runtime\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hexa.NET.GLFW" Version="1.0.4" />
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.7" />
    <PackageReference Include="Hexa.NET.ImGui.Backends" Version="1.0.15" />
    <PackageReference Include="Hexa.NET.ImGui.Backends.GLFW" Version="1.0.15" />
    <PackageReference Include="Hexa.NET.ImGui.Widgets" Version="1.2.13" />
    <PackageReference Include="Hexa.NET.ImGuizmo" Version="2.2.7" />
    <PackageReference Include="Hexa.NET.OpenGL.Core" Version="1.1.0" />
    <PackageReference Include="Hexa.NET.OpenGL4" Version="1.1.0" />
    <PackageReference Include="Hexa.NET.OpenGLES.Core" Version="1.1.0" />
    <PackageReference Include="Hexa.NET.SDL2" Version="1.2.14" />
  </ItemGroup>

</Project>
